<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/player_background_color">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/player_file_icon_size"
        android:layout_height="@dimen/player_file_icon_size"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/video_white" />

    <ImageView
        android:id="@+id/thumbnail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <SurfaceView
        android:id="@+id/surfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="gone" />

    <TextView
        android:id="@+id/seekIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:layout_margin="@dimen/standard_padding"
        android:background="@drawable/player_seek_indicator_background"
        android:importantForAccessibility="no"
        android:paddingHorizontal="@dimen/standard_padding"
        android:paddingVertical="@dimen/standard_half_padding"
        android:textColor="@color/player_default_text_color"
        android:textSize="@dimen/txt_size_16sp"
        android:visibility="gone" />

    <com.nextcloud.client.player.ui.control.PlayerControlView
        android:id="@+id/playerControlView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/player_video_control_scrim" />

</FrameLayout>
